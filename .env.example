# PostgreSQL connection string used by Prisma.
# For Vercel, create or connect a Postgres database and add this value in
# Project Settings → Environment Variables for Production/Preview/Development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/career_mentor?schema=public"

# Required in Vercel so authentication cookies/tokens can be signed.
# Generate a strong value, for example: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# Public app URL used when creating password-reset links.
# Example: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional AI providers. Configure one provider to enable external AI responses.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# GOOGLE_API_KEY can be used instead of GEMINI_API_KEY.
GOOGLE_API_KEY=""
